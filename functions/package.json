{
  "name": "functions",
  "version": "1.0.0",
  "description": "Firebase Functions for Attendance Tracker",
  "main": "lib/index.js",
  "engines": {
    "node": "18"
  },
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
