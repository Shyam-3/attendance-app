    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "@supabase/supabase-js": "^2.49.9",
    "express": "^4.21.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "morgan": "^1.10.0",
    "prisma": "^6.9.0",
    "multer": "^1.4.5-lts.2",
    "exceljs": "^4.4.0",
    "pdfkit": "^0.16.0",
    "firebase-functions": "^6.3.2"
  },
  "devDependencies": {
    "@types/pg": "^8.15.6",
    "typescript": "~5.8.3",
    "@types/node": "^22.15.30",
    "@types/express": "^5.0.3",
    "@types/cors": "^2.8.18",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/pdfkit": "^0.13.9"
  }
